{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "baseUrl": "./",
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "react-virtual-keyboard": ["src"],
      "react-virtual-keyboard/*": ["src/*", "*"],
      "rc-virtual-keyboard": ["src"],
      "rc-virtual-keyboard/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "docs-app/**/*", "vite.config.mjs", "vite.lib.config.mjs"]
}
